# Dependency cooldown (T1) — refuse to resolve any version published in the last
# N days. The single highest-value supply-chain control available to us, and it
# costs nothing.
#
# Most malicious package versions are caught and yanked fast: Shai-Hulud in
# ~12 hours, the September 2025 debug/chalk compromise in ~2.5 hours. A one-day
# cooldown would have blocked both, with no signature database and no triage.
#
# UNITS ARE DAYS. npm uses days; pnpm and Yarn use minutes. Setting this to 1440
# by copying a pnpm config would give a four-year cooldown, not a one-day one.
#
# Requires npm >= 11.10.0 (Feb 2026). OLDER NPM IGNORES THIS KEY SILENTLY — the
# control would look present and do nothing. package.json pins the floor via
# "engines".
min-release-age=1

# Install-script containment (T2) is deliberately NOT set here as
# `ignore-scripts=true`. A blanket .npmrc setting currently defeats npm's own
# `allowScripts` review tooling (npm/cli#9450). The flag is applied on the CI
# install invocation instead — see .github/workflows/ci.yml — so that migrating
# to `npm approve-scripts` later does not require untangling this file.
